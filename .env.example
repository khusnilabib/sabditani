# Salin ke .env.local (web) atau gunakan EAS Secrets untuk admin.
# JANGAN pernah memasukkan service_role ke aplikasi klien.

# Web (Next.js) — static export ke Cloudflare Pages
NEXT_PUBLIC_SITE_URL=https://sabditani.pages.dev
# REVALIDATE_SECRET hanya dipakai bila web dijalankan dengan ISR/Vercel, bukan static export

# Admin (Expo) — wajib diisi; mode demo sudah dinonaktifkan
EXPO_PUBLIC_SUPABASE_URL=https://uzjskaeqenfwsyoxceqx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=https://sabditani-api.khusnilabib02.workers.dev

# Worker (Cloudflare) — diatur dengan `wrangler secret put`
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=khusnilabib/sabditani
# WEB_REVALIDATE_URL=https://sabditani.id/api/revalidate  # opsional, untuk deployment ISR
REVALIDATE_SECRET=
ALLOWED_ORIGIN=https://sabditani.pages.dev
